# Local development only. Generate the real values with:
#   npm run db:start && npm run env:local
# Public (safe in the browser; RLS protects data):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Dev scripts only (create-dev-users, migrations) — never prefix with NEXT_PUBLIC_, never deploy:
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
