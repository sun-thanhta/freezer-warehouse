# Copy to .env.local and fill from Supabase Dashboard → Project Settings
# --- dùng bởi app (Vercel cũng cần 2 biến này) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# --- chỉ dùng cho `npm run db:setup` (KHÔNG đưa lên Vercel, KHÔNG commit) ---
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
# Connect → Session pooler (IPv4), ví dụ:
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
