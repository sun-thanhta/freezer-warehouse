# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API Keys / Connect
# --- dùng bởi app (Vercel cũng cần 2 biến này) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # hoặc NEXT_PUBLIC_SUPABASE_ANON_KEY (key kiểu cũ)

# --- chỉ dùng cho npm run db:setup / db:seed / db:test (KHÔNG đưa lên Vercel, KHÔNG commit) ---
SUPABASE_SECRET_KEY=sb_secret_...                          # hoặc SUPABASE_SERVICE_ROLE_KEY (key kiểu cũ)
# Connect → Session pooler (IPv4, cổng 5432). Ký tự đặc biệt trong mật khẩu phải mã hóa URL (@ → %40)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
